# Quote form (server-side only; never prefix these with NEXT_PUBLIC_) ---
# The /api/contact route emails enquiries through Resend (https://resend.com).
# Set these in .env.local for local testing and in Vercel → Settings → Environment Variables.
RESEND_API_KEY=re_your_api_key
# Must be an address on a domain verified in Resend, e.g. "SriAero Website <quotes@sriaero.ca>"
CONTACT_FROM_EMAIL="SriAero Website <noreply@your-verified-domain.ca>"
CONTACT_TO_EMAIL=info@sriaero.ca
