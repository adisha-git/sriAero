# Quote form (server-side only; never prefix these with NEXT_PUBLIC_) ---
# The /api/contact route emails enquiries through Resend (https://resend.com).
# Set these in .env.local for local testing and in Vercel → Settings → Environment Variables.
RESEND_API_KEY=re_your_api_key
# Must be an address on a domain verified in Resend, e.g. "SriAero Website <quotes@sriaero.ca>"
CONTACT_FROM_EMAIL="SriAero Website <noreply@your-verified-domain.ca>"
CONTACT_TO_EMAIL=info@sriaero.ca

# Spam protection --------------------------------------------------------
# Cloudflare Turnstile (https://dash.cloudflare.com → Turnstile). The site key is public by design and is
# embedded in the page; the secret key is server-only.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your_turnstile_site_key
TURNSTILE_SECRET_KEY=your_turnstile_secret_key
# Optional: comma-separated hostnames Turnstile tokens may come from. Defaults to www.sriaero.ca and sriaero.ca.
# TURNSTILE_ALLOWED_HOSTNAMES=www.sriaero.ca,sriaero.ca

# Upstash Redis REST credentials for shared rate limiting (5 requests / 10 minutes per IP).
# The Vercel Marketplace integration's KV_REST_API_URL / KV_REST_API_TOKEN also work.
UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_rest_token
